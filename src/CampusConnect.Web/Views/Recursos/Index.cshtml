@model CampusConnect.Web.Models.ViewModels.RecursoIndexViewModel
@using CampusConnect.Web.Models.Enums
@{
    ViewData["Title"] = "Gestión de Recursos";
}

<div class="row align-items-center mb-4">
    <div class="col-md-7">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-hdd-network text-primary me-2"></i>Gestión de Recursos
        </h2>
        <p class="text-muted mb-0">Inventario y control del estado operativo de equipamiento e infraestructura universitaria.</p>
    </div>
    <div class="col-md-5 text-md-end mt-3 mt-md-0">
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Recurso
        </a>
    </div>
</div>

<!-- Tarjetas de resumen de recursos -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <div class="card kpi-card bg-white p-3 border-start border-4 border-primary">
            <span class="text-muted text-uppercase small fw-semibold">Total Recursos</span>
            <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalRecursos</h3>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card kpi-card bg-white p-3 border-start border-4 border-success">
            <span class="text-muted text-uppercase small fw-semibold">Disponibles / Operativos</span>
            <h3 class="fw-bold text-success mt-1 mb-0">@Model.TotalDisponibles</h3>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card kpi-card bg-white p-3 border-start border-4 border-warning">
            <span class="text-muted text-uppercase small fw-semibold">En Mantenimiento</span>
            <h3 class="fw-bold text-warning mt-1 mb-0">@Model.TotalEnMantenimiento</h3>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card kpi-card bg-white p-3 border-start border-4 border-danger">
            <span class="text-muted text-uppercase small fw-semibold">Fuera de Servicio</span>
            <h3 class="fw-bold text-danger mt-1 mb-0">@Model.TotalFueraDeServicio</h3>
        </div>
    </div>
</div>

<!-- Buscador y Filtros -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control bg-light border-start-0" 
                           placeholder="Buscar por código, nombre o ubicación..." />
                </div>
            </div>
            <div class="col-sm-6 col-md-3">
                <select name="tipo" class="form-select" onchange="this.form.submit()">
                    <option value="">Todos los Tipos</option>
                    @foreach (TipoRecurso t in Enum.GetValues(typeof(TipoRecurso)))
                    {
                        if (Model.TipoFiltro == t)
                        {
                            <option value="@t" selected>@t</option>
                        }
                        else
                        {
                            <option value="@t">@t</option>
                        }
                    }
                </select>
            </div>
            <div class="col-sm-6 col-md-3">
                <select name="estado" class="form-select" onchange="this.form.submit()">
                    <option value="">Todos los Estados</option>
                    @foreach (EstadoRecurso e in Enum.GetValues(typeof(EstadoRecurso)))
                    {
                        if (Model.EstadoFiltro == e)
                        {
                            <option value="@e" selected>@e</option>
                        }
                        else
                        {
                            <option value="@e">@e</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-dark w-100" title="Filtrar"><i class="bi bi-filter"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Listado de Recursos -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-uppercase text-muted">
                <tr>
                    <th>Código</th>
                    <th>Nombre del Recurso</th>
                    <th>Tipo</th>
                    <th>Ubicación Física</th>
                    <th>Estado Operativo</th>
                    <th>Fecha Registro</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Recursos.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-4 d-block mb-2 text-secondary opacity-50"></i>
                            No se encontraron recursos registrados con los criterios seleccionados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Recursos)
                    {
                        <tr>
                            <td>
                                <strong class="text-primary font-monospace">@item.Codigo</strong>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@item.Nombre</div>
                                @if (!string.IsNullOrEmpty(item.Descripcion))
                                {
                                    <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">@item.Descripcion</small>
                                }
                            </td>
                            <td>
                                @if (item.Tipo == TipoRecurso.Equipamiento)
                                {
                                    <span class="badge bg-light text-primary border border-primary-subtle">
                                        <i class="bi bi-laptop me-1"></i>Equipamiento
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-info border border-info-subtle">
                                        <i class="bi bi-building me-1"></i>Infraestructura
                                    </span>
                                }
                            </td>
                            <td>
                                <i class="bi bi-geo-alt text-danger me-1"></i>@item.Ubicacion
                            </td>
                            <td>
                                @switch (item.Estado)
                                {
                                    case EstadoRecurso.Disponible:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Disponible
                                        </span>
                                        break;
                                    case EstadoRecurso.EnUso:
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                            <i class="bi bi-play-circle-fill me-1"></i>En Uso
                                        </span>
                                        break;
                                    case EstadoRecurso.EnMantenimiento:
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-tools me-1"></i>En Mantenimiento
                                        </span>
                                        break;
                                    case EstadoRecurso.FueraDeServicio:
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-x-circle-fill me-1"></i>Fuera de Servicio
                                        </span>
                                        break;
                                }
                            </td>
                            <td class="small text-muted">
                                @item.FechaRegistro.ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Ver Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="Eliminar / Desactivar"
                                            data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>

                                <!-- Modal Confirmación Eliminación -->
                                <div class="modal fade text-start" id="deleteModal-@item.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form method="post" asp-action="Delete" asp-route-id="@item.Id">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold text-danger">
                                                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    ¿Estás seguro de que deseas eliminar o desactivar el recurso <strong>@item.Codigo - @item.Nombre</strong>?
                                                    <p class="text-muted small mt-2 mb-0">Si el recurso cuenta con solicitudes históricas asociadas, se marcará automáticamente como 'Fuera de Servicio' para no alterar los reportes de auditoría.</p>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                    <button type="submit" class="btn btn-danger">Eliminar / Desactivar</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
